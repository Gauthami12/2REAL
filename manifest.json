{
  "manifest_version": 3,

  "name": "GenZify",

  "version": "1.0",

  "description": "Because normal is kinda mid.",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/*",
        "https://www.google.co.in/*"
      ],

      "js": [
        "content.js"
      ],

      "run_at": "document_start"
    }
  ]
}
